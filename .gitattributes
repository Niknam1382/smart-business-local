# همه‌ی فایل‌های متنی در مخزن با LF ذخیره می‌شن (پروژه روی لینوکس/CI ساخته می‌شه).
* text=auto eol=lf

# اسکریپت‌های shell حتماً LF بمانند، وگرنه روی macOS/Linux با «bad interpreter: /bin/bash^M» می‌شکنن
# ( همین فایل‌ها در run-from-source.sh / scripts/ci_fail_report.sh استفاده می‌شن).
*.sh text eol=lf
*.bash text eol=lf

# ویندوز: فایل‌های batch با CRLF کار می‌کنن و نصب‌کننده‌ی Inno هم UTF-8 with BOM است
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf

# باینری‌ها (هیچ‌وقت تبدیلِ خط/کدگذاری رویشون انجام نشه)
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ico binary
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.webp binary
*.exe binary
*.dll binary
*.pyd binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
